<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ChickenCoop</AssemblyName>
    <RootNamespace>ChickenCoop</RootNamespace>
    <Version>1.3.2</Version>
    <Authors>Gdaki</Authors>
    <Description>Chicken Coop: pet chickens for CS2, by Gdaki (co-authored with Claude by Anthropic)</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Lives in counterstrikesharp/shared/ChickenCoop.Shared/ on the server, so other plugins see the same types. -->
    <ProjectReference Include="../shared/ChickenCoop.Shared/ChickenCoop.Shared.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="lang\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
