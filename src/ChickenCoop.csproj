<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ChickenCoop</AssemblyName>
    <RootNamespace>ChickenCoop</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Gdaki</Authors>
    <Description>Chicken Coop: pet chickens for CS2, by Gdaki</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="lang\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
