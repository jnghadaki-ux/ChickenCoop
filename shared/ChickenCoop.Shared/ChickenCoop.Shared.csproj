<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ChickenCoop.Shared</AssemblyName>
    <RootNamespace>ChickenCoop.Shared</RootNamespace>
    <Version>1.1.0</Version>
    <Authors>Gdaki</Authors>
    <Description>Chicken Coop plugin API: lets other CounterStrikeSharp plugins read and reward pets.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
